---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import TodoApp from '../../components/TodoApp';
import type { TodoList } from '../../lib/todo-types';

const { id } = Astro.params;

let sharedList: TodoList | null = null;
let error = false;

if (id) {
  try {
    sharedList = JSON.parse(atob(id)) as TodoList;
  } catch (e) {
    error = true;
  }
}
---

<Layout
  title={sharedList ? `${sharedList.name} - Easy Todo List` : 'Shared List - Easy Todo List'}
  description={sharedList ? `View ${sharedList.name} shared with you` : 'View a shared todo list'}
>
  <div class="bg-canvas-soft min-h-[calc(100vh-64px)]">
    {error ? (
      <div class="max-w-md mx-auto px-4 py-16 text-center">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-error-soft flex items-center justify-center">
          <svg class="w-8 h-8 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h1 class="text-display-sm text-ink mb-2">Invalid Share Link</h1>
        <p class="text-body text-mute mb-6">This shared list link is invalid or has expired.</p>
        <a
          href="/app"
          class="inline-flex items-center justify-center h-10 px-6 text-button-md font-[500] text-on-primary bg-primary rounded-pill hover:opacity-90 transition-opacity"
        >
          Create Your Own List
        </a>
      </div>
    ) : (
      <TodoApp client:load sharedList={sharedList} />
    )}
  </div>
</Layout>