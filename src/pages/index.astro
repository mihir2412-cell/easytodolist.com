              To maintain a todo list effectively, review it daily and update tasks. Add new items immediately, remove completed tasks, and break large projects into smaller actionable items. Prioritize based on urgency and importance, and schedule regular reviews—at the start or end of each day. Consistency is key: the best todo list is one you actually use.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const faqTriggers = document.querySelectorAll('.faq-trigger');
      faqTriggers.forEach(function(trigger) {
        trigger.addEventListener('click', function() {
          const isExpanded = this.getAttribute('aria-expanded') === 'true';
          const content = this.nextElementSibling;
          const icon = this.querySelector('.faq-icon');

          // Close all other FAQs (optional accordion behavior)
          faqTriggers.forEach(function(otherTrigger) {
            if (otherTrigger !== trigger) {
              otherTrigger.setAttribute('aria-expanded', 'false');
              const otherContent = otherTrigger.nextElementSibling;
              const otherIcon = otherTrigger.querySelector('.faq-icon');
              if (otherContent) otherContent.classList.add('hidden');
              if (otherIcon) otherIcon.classList.remove('rotate-180');
            }
          });

          // Toggle current FAQ
          this.setAttribute('aria-expanded', !isExpanded);
          if (content) content.classList.toggle('hidden');
          if (icon) icon.classList.toggle('rotate-180');
        });
      });
    });
  </script>
</Layout>